# ==============================================================================
# ZAP (Zero Answer Policy) — Environment Variables Template (.env.example)
# Sesuai Ketentuan Guidebook LOGICODIX 2026: Keamanan Kredensial & Instalasi
# Salin berkas ini ke .env (root & backend) atau frontend/.env.local sebelum menjalankan aplikasi.
# JANGAN PERNAH MENGISI DAN MENGUNGGAH NILAI ASLI KE DALAM REPOSITORI PUBLIK!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Backend Platform (FastAPI & zapcore)
# ------------------------------------------------------------------------------
# Kunci rahasia untuk menandatangani sesi JWT (HS256)
ZAP_JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Kunci master enkripsi AES-256-GCM (32 bytes base64 atau string master secret)
ZAP_MASTER_SECRET=your_master_secret_passphrase_for_vault

# Google OAuth 2.0 Client ID & Secret untuk verifikasi server-side ID token
ZAP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
ZAP_GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Kunci Gemini Platform (disediakan di server agar juri/pengguna langsung pakai tanpa setup manual)
ZAP_GEMINI_API_KEY=your_platform_gemini_api_key

# Jalur basis data SQLite (bawaan: zap_platform.db)
ZAP_DB_PATH=zap_platform.db

# Masa aktif sesi dan retensi privasi (hari)
ZAP_SESSION_DAYS=7
ZAP_RETENTION_DAYS=365

# ------------------------------------------------------------------------------
# 2. Konfigurasi Frontend (Next.js 14)
# ------------------------------------------------------------------------------
# Tautan endpoint microservice backend ZAP
# Lokal: http://127.0.0.1:8000 | Produksi: https://api.chatzap.web.id
NEXT_PUBLIC_BACKEND_URL=https://api.chatzap.web.id

# (Opsional) URL Basis Data PostgreSQL untuk Produksi (Neon / Supabase / VPS Postgres)
DATABASE_URL=postgresql://zap_user:zap_secure_pass@localhost:5432/zap_production

# Client ID Google OAuth di sisi peramban web
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# (Opsional) Kunci API Pihak Ketiga untuk BYOK Connector Pengguna/Juri
BAZAARLINK_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

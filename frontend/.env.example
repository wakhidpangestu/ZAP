# ZAP Frontend Environment Configuration (.env.example)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional BYOK Provider Keys
BAZAARLINK_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Penandatangan token sesi akun email/password (sinkronisasi vault terenkripsi).
# WAJIB di produksi: minimal 32 karakter acak, contoh cara membuat:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Bila kosong, server membuat secret acak dan menyimpannya di
# .zap_vault/security/session-secret (hanya cocok untuk satu node).
ZAP_SESSION_SECRET=
